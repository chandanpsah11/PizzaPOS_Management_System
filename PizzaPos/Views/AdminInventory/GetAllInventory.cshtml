@model IEnumerable<MODELS.InventoryItemModel>
@{
    ViewBag.Title = "Inventory";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div style="margin-bottom:15px">
    <h2 style="display:inline-block">Inventory</h2>
    <a href="@Url.Action("AddInventory", "AdminInventory")"
       class="btn btn-primary pull-right">
        + Add Item
    </a>
</div>

<div style="overflow-x:auto; overflow-y:auto; max-height:500px; width:100%">
    <table class="table table-bordered table-striped table-hover"
           style="min-width:700px; margin-bottom:0">
        <thead style="position:sticky; top:0; background:#fff; z-index:1">
            <tr>
                <th>@Html.DisplayNameFor(m => m.itemid)</th>
                <th>@Html.DisplayNameFor(m => m.ItemName)</th>
                <th>@Html.DisplayNameFor(m => m.CurrentStock)</th>
                <th>@Html.DisplayNameFor(m => m.UOMId)</th>
                <th>@Html.DisplayNameFor(m => m.LastAddedStockDate)</th>
                <th style="width:160px">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(m => item.itemid)</td>
                    <td>@Html.DisplayFor(m => item.ItemName)</td>
                    <td>@Html.DisplayFor(m => item.CurrentStock)</td>
                    <td>@Html.DisplayFor(m => item.UOMId)</td>
                    <td>@Html.DisplayFor(m => item.LastAddedStockDate)</td>
                    <td>
                        @Html.ActionLink("Edit", "EditItem", new { id = item.itemid }, new { @class = "btn btn-xs btn-warning" })
                        @Html.ActionLink("Delete", "DeleteItem", new { id = item.itemid }, new { @class = "btn btn-xs btn-danger" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>