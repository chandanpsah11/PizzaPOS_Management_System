@model MODELS.InventoryItemModel
@{
    ViewBag.Title = "Add Inventory";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid" style="margin-top:20px">
    <div class="row">
        <div class="col-xs-12 col-sm-7 col-md-6 col-lg-5">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h4 class="panel-title">
                        <span class="glyphicon glyphicon-plus"></span>
                        Add Inventory Item
                    </h4>
                </div>
                <div class="panel-body">

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-group">
                            @Html.LabelFor(model => model.ItemName,
                                htmlAttributes: new { @class = "control-label" })
                            @Html.EditorFor(model => model.ItemName,
                                new { htmlAttributes = new { @class = "form-control", placeholder = "Enter item name" } })
                            @Html.ValidationMessageFor(model => model.ItemName, "",
                                new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.CurrentStock,
                                htmlAttributes: new { @class = "control-label" })
                            @Html.EditorFor(model => model.CurrentStock,
                                new { htmlAttributes = new { @class = "form-control", placeholder = "0" } })
                            @Html.ValidationMessageFor(model => model.CurrentStock, "",
                                new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.UOMId,
                                htmlAttributes: new { @class = "control-label" })
                            @Html.DropDownListFor(model => model.UOMId,
                                ViewBag.UOM as SelectList,
                                "-- Select Unit --",
                                new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.UOMId, "",
                                new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.LastAddedStockDate,
                                htmlAttributes: new { @class = "control-label" })
                            @Html.EditorFor(model => model.LastAddedStockDate,
                                new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.LastAddedStockDate, "",
                                new { @class = "text-danger" })
                        </div>

                        <div class="row" style="margin-top:24px">
                            <div class="col-xs-12 col-sm-6" style="margin-bottom:10px">
                                <input type="submit"
                                       value="Add Item"
                                       class="btn btn-primary btn-block" />
                            </div>
                            <div class="col-xs-12 col-sm-6">
                                @Html.ActionLink("Back to List", "Index",
                                    null, new { @class = "btn btn-default btn-block" })
                            </div>
                        </div>
                    }

                </div>
            </div>
        </div>
        <div class="hidden-xs col-sm-5 col-md-6 col-lg-7
                    text-center"
             style="display:flex;
                    align-items:center;
                    justify-content:center;
                    padding-top:40px">
            <div>
                <div style="font-size:180px; line-height:1; user-select:none">
                    🍕
                </div>
                <h3 class="text-muted" style="margin-top:16px; font-weight:300; letter-spacing:1px">
                    Pizza POS
                </h3>
                <p class="text-muted">
                    Manage your ingredients &amp; stock
                </p>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}