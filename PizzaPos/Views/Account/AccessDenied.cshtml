
<div class="container text-center" style="margin-top:80px">
    <div class="panel panel-danger" style="display:inline-block; min-width:400px">
        <div class="panel-heading">
            <h3 class="panel-title">Access Denied</h3>
        </div>
        <div class="panel-body">
            <p>You do not have permission to view this page.</p>
            @Html.ActionLink("Go to Home", "Index", "Home",
                null, new { @class = "btn btn-default" })
            @Html.ActionLink("Logout", "Logout", "Account",
                null, new { @class = "btn btn-danger" })
        </div>
    </div>
</div>
