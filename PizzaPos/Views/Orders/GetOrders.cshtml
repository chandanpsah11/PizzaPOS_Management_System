@model List<MODELS.OrderListViewModel>
@{
    ViewBag.Title = "Order History";
    Layout = User.IsInRole("Admin") ? "~/Views/Shared/_AdminLayout.cshtml"
                                    : "~/Views/Shared/_EmployeeLayout.cshtml";
}

<div class="container-fluid" style="margin-top:20px">

    <div class="row">
        <div class="col-xs-12">
            <h2 class="text-center visible-xs-block">Order History</h2>
            <h2 class="hidden-xs">Order History</h2>
        </div>
    </div>
    <div class="row hidden-xs">
        <div class="col-xs-12">
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover table-condensed">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Date</th>
                            <th>Pizza Name</th>
                            <th class="hidden-sm">Size</th>
                            <th>Qty</th>
                            <th class="hidden-sm">Unit Price</th>
                            <th>Line Total</th>
                            <th class="hidden-sm">Payment</th>
                            <th>Order Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            bool first = true;
                            foreach (var item in order.Items)
                            {
                                <tr>
                                    <td>
                                        <span class="label label-default">#@order.OrderId</span>
                                    </td>
                                    <td class="text-nowrap">
                                        <div>@order.OrderDate.ToString("dd MMM yyyy")</div>
                                        <small class="text-muted">@order.OrderDate.ToString("hh:mm tt")</small>
                                    </td>
                                    <td>@item.PizzaName</td>
                                    <td class="hidden-sm">@item.SizeName</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="hidden-sm text-right">@item.UnitPrice.ToString("N2")</td>
                                    <td class="text-right">@item.LineTotal.ToString("N2")</td>
                                    <td class="hidden-sm">
                                        <span class="label label-info">@order.PaymentMode</span>
                                    </td>
                                    <td class="text-right">
                                        @if (first)
                                        {
                                            <strong>@order.TotalAmount.ToString("N2")</strong>
                                            first = false;
                                        }
                                        else
                                        {
                                            <span class="text-muted">&mdash;</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="row visible-xs-block">
        <div class="col-xs-12">

            @foreach (var order in Model)
            {
                <div class="panel panel-default">

                    <div class="panel-heading">
                        <div class="row">
                            <div class="col-xs-6">
                                <strong>
                                    <span class="glyphicon glyphicon-list-alt"></span>
                                    Order #@order.OrderId
                                </strong>
                            </div>
                            <div class="col-xs-6 text-right">
                                <span class="label label-info">@order.PaymentMode</span>
                            </div>
                        </div>
                        <div class="row" style="margin-top:4px">
                            <div class="col-xs-12">
                                <small class="text-muted">
                                    <span class="glyphicon glyphicon-time"></span>
                                    @order.OrderDate.ToString("dd MMM yyyy, hh:mm tt")
                                </small>
                            </div>
                        </div>
                    </div>

                    <div class="panel-body" style="padding:0">
                        <table class="table table-condensed table-striped" style="margin-bottom:0">
                            <thead>
                                <tr>
                                    <th>Pizza</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-right">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in order.Items)
                                {
                                    <tr>
                                        <td>
                                            <div>@item.PizzaName</div>
                                            <small class="text-muted">@item.SizeName &bull; @item.UnitPrice.ToString("N2") each</small>
                                        </td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-right">@item.LineTotal.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="panel-footer">
                        <div class="row">
                            <div class="col-xs-6">
                                <strong>Order Total</strong>
                            </div>
                            <div class="col-xs-6 text-right">
                                <strong class="text-primary">@order.TotalAmount.ToString("N2")</strong>
                            </div>
                        </div>
                    </div>

                </div>
            }

        </div>
    </div>

</div>