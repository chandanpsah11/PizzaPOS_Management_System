@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@{
    TimeZoneInfo ist = TimeZoneInfo.FindSystemTimeZoneById("India Standard Time");
    DateTime now = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, ist);

    string greeting;
    if (now.Hour < 12)
    {
        greeting = "Good Morning";
    }
    else if (now.Hour < 17)
    {
        greeting = "Good Afternoon";
    }
    else
    {
        greeting = "Good Evening";
    }
}
<div class="text-center">
    <h1 style="color:burlywood">@greeting, Admin! 🍕</h1>
    <h4 style="color:burlywood">
        It's @now.ToString("hh:mm tt") now — @now.ToString("dddd, dd MMMM yyyy")
    </h4>
</div>
<div class="row" style="margin-top:20px">
    <div class="col-md-4">
        <div class="panel panel-success">
            <div class="panel-heading">
                <h4 class="panel-title">
                    <span class="glyphicon glyphicon-shopping-cart"></span>
                    Yesterday's Total Sales
                </h4>
            </div>
            <div class="panel-body text-center">
                <h2>&#8377;@ViewBag.YesterdaySales.ToString("N2")</h2>
            </div>
        </div>
    </div>
</div>