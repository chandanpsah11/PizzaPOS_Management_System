
@model MODELS.InventoryItemModelCreate

@{

    Layout = null;
}
@using (Html.BeginForm("SaveInventory", "AdminInventory", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.itemid)

    <div class="form-group">
        @Html.LabelFor(m => m.ItemName, new { @class = "control-label" })
        @Html.EditorFor(m => m.ItemName, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter item name" } })
        @Html.ValidationMessageFor(m => m.ItemName, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.CurrentStock, new { @class = "control-label" })
        @Html.EditorFor(m => m.CurrentStock, new { htmlAttributes = new { @class = "form-control", placeholder = "0" } })
        @Html.ValidationMessageFor(m => m.CurrentStock, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Unitid, new { @class = "control-label" })
        @Html.DropDownListFor(m => m.Unitid, ViewBag.UOM as SelectList,
            "-- Select Unit --", new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Unitid, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.LastAddedStockDate, new { @class = "control-label" })
        @Html.EditorFor(m => m.LastAddedStockDate, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(m => m.LastAddedStockDate, "", new { @class = "text-danger" })
    </div>

    <div class="text-right" style="margin-top:20px">
        <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
        <input type="submit"
               value="@(Model.itemid == 0 ? "Add Item" : "Update Item")"
               class="btn btn-primary" />
    </div>
}
