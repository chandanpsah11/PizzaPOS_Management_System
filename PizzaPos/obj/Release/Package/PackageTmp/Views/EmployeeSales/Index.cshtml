@model IEnumerable<MODELS.SalesPizzaModel>
@{
    ViewBag.Title = "Sales";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .sales-wrapper {
        display: flex;
        height: calc(100vh - 120px);
    }

    .pizza-list-panel {
        flex: 1;
        overflow-y: auto;
        padding: 15px;
        border-right: 2px solid #ddd;
    }

    .order-panel {
        width: 360px;
        min-width: 320px;
        display: flex;
        flex-direction: column;
        background: #fafafa;
        padding: 15px;
    }

    .pizza-card {
        border: 1px solid #ddd;
        border-radius: 6px;
        padding: 14px 16px;
        margin-bottom: 10px;
        cursor: pointer;
        background: #fff;
        transition: background 0.15s, box-shadow 0.15s;
    }

        .pizza-card:hover {
            background: #f0f7ff;
            box-shadow: 0 2px 8px rgba(0,0,0,0.10);
        }

        .pizza-card h4 {
            margin: 0 0 4px;
        }

        .pizza-card small {
            color: #888;
        }

    .order-panel h4 {
        margin-top: 0;
        border-bottom: 1px solid #ddd;
        padding-bottom: 8px;
    }

    .order-items-list {
        flex: 1;
        overflow-y: auto;
        margin-bottom: 10px;
    }

    .order-item-row {
        background: #fff;
        border: 1px solid #e0e0e0;
        border-radius: 5px;
        padding: 8px 10px;
        margin-bottom: 7px;
        position: relative;
    }

        .order-item-row .remove-btn {
            position: absolute;
            top: 6px;
            right: 8px;
            cursor: pointer;
            color: #c0392b;
            font-size: 16px;
            font-weight: bold;
            line-height: 1;
        }

    .order-total-box {
        border-top: 2px solid #333;
        padding-top: 10px;
        font-size: 16px;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .empty-order-msg {
        color: #aaa;
        text-align: center;
        margin-top: 40px;
    }

    .payment-bar {
        border-top: 1px solid #ddd;
        padding-top: 10px;
    }

    @@media (max-width: 767px) {
        .sales-wrapper {
            flex-direction: column;
            height: auto;
        }

        .pizza-list-panel {
            border-right: none;
            border-bottom: none;
            padding: 10px;
            height: auto;
            overflow-y: visible;
        }

        .order-toggle-bar {
            display: flex !important;
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: #31708f;
            color: #fff;
            padding: 12px 16px;
            z-index: 1040;
            align-items: center;
            justify-content: space-between;
            cursor: pointer;
        }

        .order-panel {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            width: 100%;
            min-width: 0;
            height: 75vh;
            z-index: 1050;
            border-top: 2px solid #31708f;
            border-radius: 14px 14px 0 0;
            box-shadow: 0 -4px 20px rgba(0,0,0,0.18);
            transform: translateY(100%);
            transition: transform 0.3s ease;
            padding: 16px;
            padding-bottom: 70px;
        }

            .order-panel.drawer-open {
                transform: translateY(0);
            }

        .sales-wrapper {
            padding-bottom: 60px;
        }
    }

    @@media (min-width: 768px) {
        .order-toggle-bar {
            display: none !important;
        }
    }
</style>
<div class="container-fluid text-center">
    <h1 style="color:burlywood">Pizza Order Placing Pannel</h1>
</div>
<div class="text-center hidden-xs hidden-sm">
    <div style="font-size:5rem; line-height:1;">🍕</div>
</div>
<hr />



<div class="order-toggle-bar hidden-sm hidden-md hidden-lg"
     id="orderToggleBar"
     onclick="toggleOrderDrawer()">
    <span>
        <span class="glyphicon glyphicon-shopping-cart"></span>
        <strong> Current Order</strong>
        <span class="badge" id="orderBadge" style="margin-left:8px;background:#e74c3c">0</span>
    </span>
    <span>
        <strong>&#8377;<span id="orderTotalMobile">0.00</span></strong>
        <span class="glyphicon glyphicon-chevron-up" id="drawerChevron" style="margin-left:8px"></span>
    </span>
</div>

<div class="sales-wrapper">

    <div class="pizza-list-panel">
        <h3 style="margin-top:0">
            <span class="glyphicon glyphicon-list"></span>
            Menu
        </h3>

        <div class="row">
            @foreach (var pizza in Model)
            {
                <div class="col-xs-6 col-sm-6 col-md-4 col-lg-3">
                    <div class="pizza-card"
                         onclick="openPizzaModal(@pizza.PizzaId, '@Html.Raw(pizza.PizzaName)')">
                        <h4>@pizza.PizzaName</h4>
                        <small>@pizza.CategoryName</small>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="order-panel" id="orderPanel">
        <div class="visible-xs-block text-right" style="margin-bottom:8px">
            <button class="btn btn-default btn-sm" onclick="toggleOrderDrawer()">
                <span class="glyphicon glyphicon-chevron-down"></span>
                Close
            </button>
        </div>

        <h4>
            <span class="glyphicon glyphicon-shopping-cart"></span>
            Current Order
        </h4>

        <div class="order-items-list" id="orderItemsList">
            <div class="empty-order-msg" id="emptyOrderMsg">
                No items added yet.
            </div>
        </div>

        <div class="order-total-box">
            Total: &#8377;<span id="orderTotal">0.00</span>
        </div>

        <div class="payment-bar">
            <div class="form-group">
                <label>Payment Mode</label>
                <select id="ddlPayment" class="form-control">
                    <option value="Cash">Cash</option>
                    <option value="Card">Card</option>
                    <option value="UPI">UPI</option>
                </select>
            </div>
            <button id="btnPlaceOrder"
                    class="btn btn-success btn-block btn-lg"
                    onclick="confirmOrder()">
                <span class="glyphicon glyphicon-ok"></span>
                Confirm &amp; Place Order
            </button>
            <button class="btn btn-default btn-block"
                    style="margin-top:6px"
                    onclick="clearOrder()">
                Clear Order
            </button>
        </div>

    </div>
</div>

<div class="modal fade" id="pizzaModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
                <h4 class="modal-title" id="modalPizzaName">Pizza</h4>
            </div>
            <div class="modal-body">

                <div id="modalLoadingMsg" class="text-center text-muted">
                    Loading sizes...
                </div>
                <div id="modalNoPrice" class="alert alert-warning" style="display:none">
                    No prices configured for this pizza yet.
                </div>

                <div id="modalSizeArea" style="display:none">
                    <div class="form-group">
                        <label>Select Size</label>
                        <select id="modalDdlSize" class="form-control"
                                onchange="onSizeChanged()">
                            <option value="">-- Select Size --</option>
                        </select>
                    </div>

                    <div id="modalPriceRow" style="display:none; margin-bottom:15px">
                        <label>Price per unit:</label>
                        <span class="label label-primary"
                              style="font-size:15px; padding:5px 10px">
                            &#8377;<span id="modalUnitPrice">0.00</span>
                        </span>
                    </div>

                    <div id="modalQtyRow" style="display:none">
                        <label>Quantity</label>
                        <div class="row" style="margin-top:8px">
                            <div class="col-xs-4 text-center">
                                <button class="btn btn-default btn-lg btn-block"
                                        onclick="changeQty(-1)">
                                    <strong>−</strong>
                                </button>
                            </div>
                            <div class="col-xs-4 text-center"
                                 style="padding-top:10px; font-size:22px; font-weight:bold">
                                <span id="modalQty">1</span>
                            </div>
                            <div class="col-xs-4 text-center">
                                <button class="btn btn-default btn-lg btn-block"
                                        onclick="changeQty(1)">
                                    <strong>+</strong>
                                </button>
                            </div>
                        </div>

                        <div class="well well-sm" style="margin-top:15px; font-size:16px">
                            <strong>Line Total: </strong>
                            &#8377;<span id="modalLineTotal">0.00</span>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default btn-block visible-xs-block"
                        data-dismiss="modal">
                    Cancel
                </button>
                <button type="button" class="btn btn-default hidden-xs"
                        data-dismiss="modal">
                    Cancel
                </button>
                <button type="button" class="btn btn-primary btn-block visible-xs-block"
                        id="btnAddToOrderXs" style="display:none"
                        onclick="addToOrder()">
                    <span class="glyphicon glyphicon-plus"></span> Add to Order
                </button>
                <button type="button" class="btn btn-primary hidden-xs"
                        id="btnAddToOrder" style="display:none"
                        onclick="addToOrder()">
                    <span class="glyphicon glyphicon-plus"></span> Add to Order
                </button>
            </div>
        </div>
    </div>
</div>

<div id="pageSuccess" class="alert alert-success"
     style="position:fixed; top:15px; right:15px;
            z-index:9999; display:none; min-width:250px">
</div>
<div id="pageError" class="alert alert-danger"
     style="position:fixed; top:15px; right:15px;
            z-index:9999; display:none; min-width:250px">
</div>

@section Scripts {
    <script>
    var currentPizzaId    = null;
    var currentPizzaName  = '';
    var currentSizePrices = [];
    var currentQty        = 1;
    var currentUnitPrice  = 0;
    var currentSizeId     = null;
    var currentSizeName   = '';
    var orderItems        = [];
    var drawerOpen        = false;
    function toggleOrderDrawer() {
        drawerOpen = !drawerOpen;
        if (drawerOpen) {
            $('#orderPanel').addClass('drawer-open');
            $('#drawerChevron')
                .removeClass('glyphicon-chevron-up')
                .addClass('glyphicon-chevron-down');
        } else {
            $('#orderPanel').removeClass('drawer-open');
            $('#drawerChevron')
                .removeClass('glyphicon-chevron-down')
                .addClass('glyphicon-chevron-up');
        }
    }
    function showSuccess(msg) {
        $('#pageSuccess').html(msg).show();
        setTimeout(function () { $('#pageSuccess').fadeOut('slow'); }, 4000);
    }
    function showError(msg) {
        $('#pageError').html(msg).show();
        setTimeout(function () { $('#pageError').fadeOut('slow'); }, 4000);
    }

    function openPizzaModal(pizzaId, pizzaName) {
        currentPizzaId   = pizzaId;
        currentPizzaName = pizzaName;
        currentQty       = 1;
        currentUnitPrice = 0;
        currentSizeId    = null;
        currentSizeName  = '';

        $('#modalPizzaName').text(pizzaName);
        $('#modalDdlSize').html('<option value="">-- Select Size --</option>');
        $('#modalLoadingMsg').show();
        $('#modalSizeArea').hide();
        $('#modalNoPrice').hide();
        $('#modalPriceRow').hide();
        $('#modalQtyRow').hide();
        $('#btnAddToOrder').hide();
        $('#btnAddToOrderXs').hide();
        $('#modalQty').text('1');
        $('#modalLineTotal').text('0.00');

        $('#pizzaModal').modal('show');

        $.ajax({
            url:  '@Url.Action("GetPizzaSizePrices", "EmployeeSales")',
            type: 'GET',
            data: { pizzaId: pizzaId },
            success: function (data) {
                $('#modalLoadingMsg').hide();
                if (!data || data.length === 0) {
                    $('#modalNoPrice').show();
                    return;
                }
                currentSizePrices = data;
                $.each(data, function (i, s) {
                    $('#modalDdlSize').append(
                        '<option value="' + s.PizzaSizeId + '" ' +
                        '        data-price="' + s.Price + '" ' +
                        '        data-name="'  + s.SizeName + '">' +
                        s.SizeName + ' — ₹' + parseFloat(s.Price).toFixed(2) +
                        '</option>'
                    );
                });
                $('#modalSizeArea').show();
            },
            error: function () {
                $('#modalLoadingMsg').hide();
                showError('Failed to load pizza sizes.');
            }
        });
    }

    function onSizeChanged() {
        var opt = $('#modalDdlSize option:selected');
        var id  = $('#modalDdlSize').val();

        if (!id) {
            $('#modalPriceRow').hide();
            $('#modalQtyRow').hide();
            $('#btnAddToOrder').hide();
            $('#btnAddToOrderXs').hide();
            return;
        }

        currentSizeId    = id;
        currentSizeName  = opt.data('name');
        currentUnitPrice = parseFloat(opt.data('price'));
        currentQty       = 1;

        $('#modalUnitPrice').text(currentUnitPrice.toFixed(2));
        $('#modalQty').text('1');
        $('#modalLineTotal').text(currentUnitPrice.toFixed(2));
        $('#modalPriceRow').show();
        $('#modalQtyRow').show();
        $('#btnAddToOrder').show();
        $('#btnAddToOrderXs').show();
    }

    function changeQty(delta) {
        currentQty = Math.max(1, currentQty + delta);
        $('#modalQty').text(currentQty);
        $('#modalLineTotal').text((currentQty * currentUnitPrice).toFixed(2));
    }

    function addToOrder() {
        if (!currentSizeId) { showError('Please select a size.'); return; }

        var lineTotal = currentQty * currentUnitPrice;
        var existing  = orderItems.find(function (o) {
            return o.PizzaId == currentPizzaId && o.PizzaSizeId == currentSizeId;
        });

        if (existing) {
            existing.Quantity += currentQty;
            existing.LineTotal = existing.Quantity * existing.UnitPrice;
        } else {
            orderItems.push({
                PizzaId:     currentPizzaId,
                PizzaName:   currentPizzaName,
                PizzaSizeId: parseInt(currentSizeId),
                SizeName:    currentSizeName,
                Quantity:    currentQty,
                UnitPrice:   currentUnitPrice,
                LineTotal:   lineTotal
            });
        }

        $('#pizzaModal').modal('hide');
        renderOrderPanel();
        showSuccess(currentPizzaName + ' added to order.');
    }

    function renderOrderPanel() {
        var list = $('#orderItemsList');
        list.find('.order-item-row').remove();

        var total = 0;
        var count = 0;

        if (orderItems.length === 0) {
            $('#emptyOrderMsg').show();
        } else {
            $('#emptyOrderMsg').hide();
            $.each(orderItems, function (i, item) {
                total += item.LineTotal;
                count += item.Quantity;
                list.append(
                    '<div class="order-item-row" id="oi_' + i + '">' +
                    '  <span class="remove-btn" onclick="removeOrderItem(' + i + ')">×</span>' +
                    '  <strong>' + item.PizzaName + '</strong>' +
                    '  <span class="label label-default" style="margin-left:6px">' + item.SizeName + '</span><br>' +
                    '  <small>Qty: ' + item.Quantity + ' &nbsp;×&nbsp; ₹' + item.UnitPrice.toFixed(2) + '</small>' +
                    '  <span style="float:right; font-weight:bold">₹' + item.LineTotal.toFixed(2) + '</span>' +
                    '</div>'
                );
            });
        }

        var totalStr = total.toFixed(2);
        $('#orderTotal').text(totalStr);
        $('#orderTotalMobile').text(totalStr);
        $('#orderBadge').text(count);
    }

    function removeOrderItem(index) {
        orderItems.splice(index, 1);
        renderOrderPanel();
    }

    function clearOrder() {
        orderItems = [];
        renderOrderPanel();
        }

    function confirmOrder() {

        var btn = $('#btnPlaceOrder');

        if (btn.prop('disabled'))
            return;

        if (orderItems.length === 0) {
            showError('Please add at least one item to the order.');
            return;
        }
        var btn = $('#btnPlaceOrder');
        var originalHtml = btn.html();

        btn.prop('disabled', true);
        btn.html('<span class="glyphicon glyphicon-refresh glyphicon-spin"></span> Placing Order...');


    var total = orderItems.reduce(function (s, o) {
        return s + o.LineTotal;
    }, 0);

    var payload = {
        CreatedByUserId: 1,
        PaymentMode: $('#ddlPayment').val(),
        TotalAmount: total,
        Items: orderItems
    };

    $.ajax({
        url: '@Url.Action("PlaceOrder", "EmployeeSales")',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(payload),

        success: function (res) {

            if (res.success) {
                showSuccess('Order placed successfully!');
                clearOrder();

                if (drawerOpen)
                    toggleOrderDrawer();
            }
            else {
                showError('Failed to place order.');
            }
        },

        error: function () {
            showError('Server error placing order.');
        },

        complete: function () {
            btn.prop('disabled', false);
            btn.html(originalHtml);
        }
    });
}

   
    </script>
}