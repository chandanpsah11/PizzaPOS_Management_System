    <EntitySetMapping Name="PizzaMasters">
      <EntityTypeMapping TypeName="PizzaPOSModel.PizzaMaster">
        <MappingFragment StoreEntitySet="PizzaMaster">
          <ScalarProperty Name="IsAvailable" ColumnName="IsAvailable" />
