<?xml version="1.0" encoding="utf-8"?>
<Mapping Space="C-S" xmlns="http://schemas.microsoft.com/ado/2009/11/mapping/cs">
  <EntityContainerMapping StorageEntityContainer="PizzaPOSModelStoreContainer" CdmEntityContainer="PizzaPOSEntities">
    <EntitySetMapping Name="ExtraToppings">
      <EntityTypeMapping TypeName="PizzaPOSModel.ExtraTopping">
